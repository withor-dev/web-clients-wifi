# Conexão com o Postgres. No Neon, use a connection string com ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wifi_dashboard

# Força SSL na conexão (true no Neon, false no Postgres local)
DATABASE_SSL=false

# Origens liberadas no CORS, separadas por vírgula (ex.: https://seu-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Segredo do HMAC usado para gerar o hash do identificador do dispositivo (LGPD)
HASH_SECRET=troque-este-segredo

PORT=3000
